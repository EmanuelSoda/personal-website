---
import BaseLayout from '../layouts/BaseLayout.astro';

const pubs = [
  {
    year: 2026,
    type: 'Article',
    title: 'Hundreds of cardiac MRI traits derived using 3D diffusion autoencoders share a common genetic architecture.',
    authors: 'Sara Ometto, Soumick Chatterjee, …, Emanuel M. Soda, …, Craig A. Glastonbury',
    journal: 'Nature Communications',
    doi: 'https://doi.org/10.1038/s41467-025-56921-7',
    pdf: null,
  },
  {
    year: 2024,
    type: 'Article',
    title: 'Automated workflow for the cell cycle analysis of (non-)adherent cells using a machine learning approach.',
    authors: 'Kourosh Hayatigolkhatmi*, Chiara Soriani*, Emanuel M. Soda* et al.',
    journal: 'eLife',
    doi: 'https://doi.org/10.7554/eLife.94830',
    pdf: 'https://elifesciences.org/articles/94830',
    note: '* co-first authors',
  },
];

const years = [...new Set(pubs.map(p => p.year))].sort((a, b) => b - a);
---

<BaseLayout title="Publications" description="Publications by Emanuel Michele Soda">
  <section class="section">
    <div class="container">
      <p class="section-label">Publications</p>
      <h1 style="font-size: clamp(2rem, 5vw, 3rem);">Papers & Preprints</h1>
      <p class="mt-2" style="max-width:560px;">
        * denotes co-first authorship.
      </p>
      <div class="pub-links-bar mt-3">
        <a href="https://scholar.google.com/scholar?q=Emanuel+Soda+computational+biology" class="ext-link" target="_blank" rel="noopener">Google Scholar ↗</a>
        <a href="https://pubmed.ncbi.nlm.nih.gov/?term=soda+EM%5BAuthor%5D" class="ext-link" target="_blank" rel="noopener">PubMed ↗</a>
        <a href="https://github.com/EmanuelSoda" class="ext-link" target="_blank" rel="noopener">GitHub ↗</a>
      </div>

      {years.map(year => (
        <div class="year-group mt-6">
          <h2 class="year-heading">{year}</h2>
          <div class="pub-list mt-3">
            {pubs.filter(p => p.year === year).map(pub => (
              <article class="pub-item">
                <div class="pub-type-badge">
                  <span class="tag">{pub.type}</span>
                </div>
                <div class="pub-body">
                  <h3 class="pub-title">{pub.title}</h3>
                  <p class="pub-authors mt-1">{pub.authors}</p>
                  <p class="pub-journal mt-1"><em>{pub.journal}</em>, {pub.year}{pub.note ? <span class="pub-note"> — {pub.note}</span> : ''}</p>
                  <div class="pub-actions mt-2">
                    {pub.doi && <a href={pub.doi} class="pub-btn" target="_blank" rel="noopener">DOI</a>}
                    {pub.pdf && <a href={pub.pdf} class="pub-btn" target="_blank" rel="noopener">PDF</a>}
                  </div>
                </div>
              </article>
            ))}
          </div>
        </div>
      ))}

      <!-- Conferences -->
      <div class="year-group mt-6">
        <h2 class="year-heading" style="color: var(--text-muted); font-size: 1.2rem;">Selected Conferences & Talks</h2>
        <div class="pub-list mt-3">
          <article class="pub-item">
            <div class="pub-type-badge"><span class="tag">Oral</span></div>
            <div class="pub-body">
              <h3 class="pub-title">Charting the molecular and Spatial Transcriptomic landscape of Crypt variability in IBD.</h3>
              <p class="pub-journal mt-1">21st European Congress on Digital Pathology (ECDP), <em>Barcelona</em>, June 2025</p>
            </div>
          </article>
          <article class="pub-item">
            <div class="pub-type-badge"><span class="tag">Poster</span></div>
            <div class="pub-body">
              <h3 class="pub-title">Charting the molecular and Spatial Transcriptomic landscape of Crypt variability in IBD.</h3>
              <p class="pub-journal mt-1">American Society of Human Genetics (ASHG), <em>Denver</em>, November 2024</p>
            </div>
          </article>
          <article class="pub-item">
            <div class="pub-type-badge"><span class="tag">Poster</span></div>
            <div class="pub-body">
              <h3 class="pub-title">Charting the molecular and Spatial Transcriptomic landscape of Crypt variability in IBD.</h3>
              <p class="pub-journal mt-1">PhD and Postdoc Symposium "Research in Motion", <em>Milan</em>, September 2025</p>
            </div>
          </article>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
.pub-links-bar { display: flex; gap: 1.5rem; flex-wrap: wrap; }
.ext-link {
  font-size: 0.82rem;
  font-weight: 500;
  color: var(--text-muted);
  border-bottom: 1px dashed var(--border);
  padding-bottom: 1px;
}
.ext-link:hover { color: var(--accent); border-color: var(--accent); }

.year-heading {
  font-family: var(--font-serif);
  font-size: 1.5rem;
  font-weight: 600;
  color: var(--accent);
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--border);
}

.pub-list { display: flex; flex-direction: column; }
.pub-item {
  display: flex;
  gap: 1.25rem;
  padding: 1.5rem 0;
  border-bottom: 1px solid var(--border);
  align-items: flex-start;
  transition: background 0.15s;
  border-radius: 6px;
}
.pub-item:hover {
  background: var(--bg-subtle);
  margin: 0 -0.75rem;
  padding-left: 0.75rem;
  padding-right: 0.75rem;
}

.pub-type-badge { padding-top: 0.15rem; flex-shrink: 0; }
.pub-title {
  font-family: var(--font-sans);
  font-size: 0.93rem;
  font-weight: 500;
  color: var(--text);
  line-height: 1.5;
}
.pub-authors { font-size: 0.82rem; color: var(--text-muted); }
.pub-journal { font-size: 0.82rem; color: var(--text-muted); }
.pub-journal em { font-style: italic; }
.pub-note { font-size: 0.78rem; opacity: 0.8; }

.pub-actions { display: flex; gap: 0.6rem; }
.pub-btn {
  font-size: 0.75rem;
  font-weight: 500;
  padding: 0.2em 0.65em;
  border: 1px solid var(--border);
  border-radius: 4px;
  color: var(--text-muted);
  transition: all 0.15s;
}
.pub-btn:hover { border-color: var(--accent); color: var(--accent); }
</style>
